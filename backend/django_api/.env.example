DB_PASSWORD=your_mysql_password
DB_NAME=pwani_bite
DB_PORT=3306
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRE_SECONDS=604800
GOOGLE_OAUTH_CLIENT_ID=
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
