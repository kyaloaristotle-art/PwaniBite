# Django API and local development server
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECRET_KEY=replace_with_a_long_random_secret

# Existing MySQL database
DB_ENGINE=mysql
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=pwani_bite
DB_PORT=3306

# Keep JWT_SECRET unchanged during cutover if current Express tokens must remain valid.
JWT_SECRET=replace_with_the_existing_jwt_secret
JWT_EXPIRE_SECONDS=604800

# Google Identity Services Web OAuth client ID (public ID; never put a client secret here)
GOOGLE_OAUTH_CLIENT_ID=

# M-Pesa integration
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=174379
MPESA_ENVIRONMENT=sandbox
SERVER_URL=https://your-public-callback-url
